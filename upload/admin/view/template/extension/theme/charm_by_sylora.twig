{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-theme" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-theme" class="form-horizontal">
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-directory"><span data-toggle="tooltip" title="{{ help_directory }}">{{ entry_directory }}</span></label>
              <div class="col-sm-10">
                <select name="theme_charm_by_sylora_directory" id="input-directory" class="form-control">
                  {% for directory in directories %}
                  {% if directory == theme_charm_by_sylora_directory %}
                  <option value="{{ directory }}" selected="selected">{{ directory }}</option>
                  {% else %}
                  <option value="{{ directory }}">{{ directory }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="theme_charm_by_sylora_status" id="input-status" class="form-control">
                  {% if theme_charm_by_sylora_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </fieldset>
          <fieldset id="hero-product-setting">
            <legend>{{ text_hero_home }}</legend>
            <div class="form-group{% if error_hero_product %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-hero-product">{{ entry_hero_product }}</label>
              <div class="col-sm-10">
                <input type="hidden" name="theme_charm_by_sylora_hero_product_id" value="{{ hero_product_id }}" id="hero-product-id">
                <div class="well well-sm" id="hero-product-selection" {% if not hero_product_id %}hidden{% endif %}>
                  <img id="hero-product-thumb" {% if hero_product %}src="{{ hero_product.thumb|e }}"{% else %}hidden{% endif %} alt="" width="40" height="40">
                  <strong id="hero-product-name">{{ hero_product_name|e }}</strong>
                  <button type="button" id="hero-product-clear" class="btn btn-default btn-sm"><i class="fa fa-times" aria-hidden="true"></i> {{ text_hero_clear }}</button>
                </div>
                <div class="dropdown">
                  <input type="search" id="input-hero-product" class="form-control" placeholder="{{ hero_product_id ? text_hero_search_again : text_hero_search }}" autocomplete="off" aria-describedby="hero-product-help" aria-controls="hero-product-results"
                    data-search-url="{{ hero_product_search_url }}"
                    data-placeholder="{{ text_hero_search }}" data-placeholder-selected="{{ text_hero_search_again }}"
                    data-empty="{{ text_hero_no_results }}" data-error="{{ text_hero_search_error }}">
                  <ul class="dropdown-menu" id="hero-product-results" aria-label="{{ entry_hero_product }}"></ul>
                </div>
                <p class="help-block" id="hero-product-feedback" role="status" hidden></p>
                <p class="alert alert-warning" id="hero-product-unavailable" {% if not hero_product_id or hero_product %}hidden{% endif %}>{{ text_hero_unavailable }}</p>
                <p class="help-block" id="hero-product-help" data-default="{{ help_hero_product }}" data-selected="{{ help_hero_selected }}">{{ hero_product ? help_hero_selected : (hero_product_id ? help_hero_unavailable : help_hero_product) }}</p>
                {% if error_hero_product %}
                <div class="text-danger" role="alert">{{ error_hero_product }}</div>
                {% endif %}
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_product }}</legend>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-catalog-limit"><span data-toggle="tooltip" title="{{ help_product_limit }}">{{ entry_product_limit }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="theme_charm_by_sylora_product_limit" value="{{ theme_charm_by_sylora_product_limit }}" placeholder="{{ entry_product_limit }}" id="input-catalog-limit" class="form-control" />
                {% if error_product_limit %}
                <div class="text-danger">{{ error_product_limit }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-description-limit"><span data-toggle="tooltip" title="{{ help_product_description_length }}">{{ entry_product_description_length }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="theme_charm_by_sylora_product_description_length" value="{{ theme_charm_by_sylora_product_description_length }}" placeholder="{{ entry_product_description_length }}" id="input-description-limit" class="form-control" />
                {% if error_product_description_length %}
                <div class="text-danger">{{ error_product_description_length }}</div>
                {% endif %}
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_image }}</legend>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-category-width">{{ entry_image_category }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_category_width" value="{{ theme_charm_by_sylora_image_category_width }}" placeholder="{{ entry_width }}" id="input-image-category-width" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_category_height" value="{{ theme_charm_by_sylora_image_category_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_category %}
                <div class="text-danger">{{ error_image_category }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-thumb-width">{{ entry_image_thumb }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_thumb_width" value="{{ theme_charm_by_sylora_image_thumb_width }}" placeholder="{{ entry_width }}" id="input-image-thumb-width" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_thumb_height" value="{{ theme_charm_by_sylora_image_thumb_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_thumb %}
                <div class="text-danger">{{ error_image_thumb }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-popup-width">{{ entry_image_popup }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_popup_width" value="{{ theme_charm_by_sylora_image_popup_width }}" placeholder="{{ entry_width }}" id="input-image-popup-width" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_popup_height" value="{{ theme_charm_by_sylora_image_popup_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_popup %}
                <div class="text-danger">{{ error_image_popup }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-product-width">{{ entry_image_product }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_product_width" value="{{ theme_charm_by_sylora_image_product_width }}" placeholder="{{ entry_width }}" id="input-image-product-width" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_product_height" value="{{ theme_charm_by_sylora_image_product_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_product %}
                <div class="text-danger">{{ error_image_product }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-additional-width">{{ entry_image_additional }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_additional_width" value="{{ theme_charm_by_sylora_image_additional_width }}" placeholder="{{ entry_width }}" id="input-image-additional-width" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_additional_height" value="{{ theme_charm_by_sylora_image_additional_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_additional %}
                <div class="text-danger">{{ error_image_additional }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-related">{{ entry_image_related }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_related_width" value="{{ theme_charm_by_sylora_image_related_width }}" placeholder="{{ entry_width }}" id="input-image-related" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_related_height" value="{{ theme_charm_by_sylora_image_related_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_related %}
                <div class="text-danger">{{ error_image_related }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-compare">{{ entry_image_compare }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_compare_width" value="{{ theme_charm_by_sylora_image_compare_width }}" placeholder="{{ entry_width }}" id="input-image-compare" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_compare_height" value="{{ theme_charm_by_sylora_image_compare_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_compare %}
                <div class="text-danger">{{ error_image_compare }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-wishlist">{{ entry_image_wishlist }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_wishlist_width" value="{{ theme_charm_by_sylora_image_wishlist_width }}" placeholder="{{ entry_width }}" id="input-image-wishlist" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_wishlist_height" value="{{ theme_charm_by_sylora_image_wishlist_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_wishlist %}
                <div class="text-danger">{{ error_image_wishlist }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-cart">{{ entry_image_cart }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_cart_width" value="{{ theme_charm_by_sylora_image_cart_width }}" placeholder="{{ entry_width }}" id="input-image-cart" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_cart_height" value="{{ theme_charm_by_sylora_image_cart_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_cart %}
                <div class="text-danger">{{ error_image_cart }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-location">{{ entry_image_location }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_location_width" value="{{ theme_charm_by_sylora_image_location_width }}" placeholder="{{ entry_width }}" id="input-image-location" class="form-control" />
                  </div>
                  <div class="col-sm-6">
                    <input type="text" name="theme_charm_by_sylora_image_location_height" value="{{ theme_charm_by_sylora_image_location_height }}" placeholder="{{ entry_height }}" class="form-control" />
                  </div>
                </div>
                {% if error_image_location %}
                <div class="text-danger">{{ error_image_location }}</div>
                {% endif %}
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
<style>
#input-hero-product { height: 38px; }
#hero-product-selection {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 60px;
  margin-bottom: 8px;
  padding: 8px 12px;
  border-color: #dcdcdc;
  background: #f7f8f9;
}
#hero-product-name { overflow-wrap: anywhere; }
#hero-product-clear { margin-left: auto; min-height: 34px; }
#hero-product-unavailable {
  margin: 8px 0;
  padding: 8px 12px;
  border-color: #e7c991;
  background: #fff6e2;
  color: #735020;
}
#hero-product-results { position: static; float: none; width: 100%; padding: 4px; }
#hero-product-results > li > a {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 48px;
  padding: 6px 12px;
  color: #116282;
  font-weight: 600;
  white-space: normal;
}
#hero-product-results > li > a:hover,
#hero-product-results > li > a:focus { background: #e8f3fa; }
#hero-product-thumb, #hero-product-results img { flex: none; object-fit: contain; }
</style>
<script>
(function() {
  var $search = $('#input-hero-product');
  var $id = $('#hero-product-id');
  var $results = $('#hero-product-results');
  var $feedback = $('#hero-product-feedback');
  var $selection = $('#hero-product-selection');
  var $thumb = $('#hero-product-thumb');
  var $name = $('#hero-product-name');
  var $unavailable = $('#hero-product-unavailable');
  var $help = $('#hero-product-help');
  var $clear = $('#hero-product-clear');
  var timer;
  var request;

  function closeSearch() {
    clearTimeout(timer);

    if (request) {
      request.abort();
      request = null;
    }

    $results.empty().hide();
    $feedback.prop('hidden', true);
  }

  function selectProduct(product) {
    closeSearch();
    $id.val(product ? product.product_id : 0);
    $search.val('').attr('placeholder', $search.attr(product ? 'data-placeholder-selected' : 'data-placeholder'));
    $help.text($help.attr(product ? 'data-selected' : 'data-default'));
    $unavailable.prop('hidden', true);
    $name.text(product ? product.name : '');
    $selection.prop('hidden', !product);
    $thumb.prop('hidden', !product);

    if (product) {
      $thumb.attr('src', product.thumb);
      $clear.trigger('focus');
    } else {
      $thumb.removeAttr('src');
      $search.trigger('focus');
    }
  }

  $clear.on('click', function() {
    selectProduct(null);
  });

  $search.on('input', function() {
    closeSearch();
    var query = $search.val().trim();
    if (!query) return;

    timer = setTimeout(function() {
      request = $.getJSON($search.attr('data-search-url'), {filter_name: query})
        .done(function(products) {
          if (!products.length) {
            $feedback.text($search.attr('data-empty')).prop('hidden', false);
            return;
          }

          products.forEach(function(product) {
            var $link = $('<a href="#"></a>').on('click', function(event) {
              event.preventDefault();
              selectProduct(product);
            });
            $link.append($('<img alt="" width="34" height="34">').attr('src', product.thumb));
            $link.append($('<span></span>').text(product.name));
            $results.append($('<li></li>').append($link));
          });
          $results.show();
        })
        .fail(function(xhr, status) {
          if (status !== 'abort') {
            $feedback.text($search.attr('data-error')).prop('hidden', false);
          }
        });
    }, 200);
  });

  $search.add($results).on('keydown', function(event) {
    if (event.key === 'Escape') {
      closeSearch();
      $search.trigger('focus');
    } else if (event.key === 'ArrowDown' && event.target === $search[0] && $results.is(':visible')) {
      event.preventDefault();
      $results.find('a').first().trigger('focus');
    } else if (event.key === 'Enter' && event.target === $search[0]) {
      event.preventDefault();
    }
  });

  $(document).on('focusin click', function(event) {
    if (event.target !== $search[0] && !$.contains($results[0], event.target)) {
      closeSearch();
    }
  });
})();
</script>
{{ footer }}