<div class="slideshow swiper-viewport">
  <div id="slideshow{{ module }}" class="swiper-container" data-slideshow data-pagination=".slideshow{{ module }}">
    <div class="swiper-wrapper"> {% for banner in banners %}
      <div class="swiper-slide text-center">{% if banner.link %}<a href="{{ banner.link }}"><img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-responsive" width="{{ width }}" height="{{ height }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}" decoding="async" /></a>{% else %}<img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-responsive" width="{{ width }}" height="{{ height }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}" decoding="async" />{% endif %}</div>
      {% endfor %} </div>
  </div>
  <div class="swiper-pagination slideshow{{ module }}"></div>
  <div class="swiper-pager">
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
  </div>
</div>
