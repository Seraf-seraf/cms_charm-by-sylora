<div class="swiper-viewport">
  <div id="banner{{ module }}" class="swiper-container" data-banner>
    <div class="swiper-wrapper">{% for banner in banners %}
      <div class="swiper-slide">{% if banner.link %}<a href="{{ banner.link }}"><img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-responsive" width="1140" height="380" loading="lazy" decoding="async" /></a>{% else %}<img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-responsive" width="1140" height="380" loading="lazy" decoding="async" />{% endif %}</div>
      {% endfor %}</div>
  </div>
</div>
