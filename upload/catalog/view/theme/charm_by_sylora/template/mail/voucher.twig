<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/1999/REC-html401-19991224/strict.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>{{ title }}</title>
</head>
<body style="margin: 0; padding: 16px; background: #f1eee6; color: #30251e; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5;">
<div style="width: 100%; max-width: 680px; margin: 0 auto;">
  <div style="float: right; max-width: 40%; margin: 0 0 16px 16px;"><a href="{{ store_url }}" title="{{ store_name }}"><img src="{{ image }}" alt="{{ store_name }}" style="max-width: 100%; height: auto; margin-bottom: 20px; border: 0;" /></a></div>
  <div>
    <p style="margin: 0 0 16px;">{{ text_greeting }}</p>
    <p style="margin: 0 0 16px;">{{ text_from }}</p>
    {% if message %}
    <p style="margin: 0 0 16px;">{{ text_message }}</p>
    <p style="margin: 0 0 16px;">{{ message }}</p>
    {% endif %}
    <p style="margin: 0 0 16px;">{{ text_redeem }}</p>
    <p style="margin: 0 0 16px;"><a href="{{ store_url }}" title="{{ store_name }}">{{ store_url }}</a></p>
    <p style="margin: 0 0 16px;">{{ text_footer }}</p>
  </div>
</div>
</body>
</html>
