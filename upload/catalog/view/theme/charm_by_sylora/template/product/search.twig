{{ header }}
<main id="product-search" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <header class="catalog-head">
        <p class="sylora-eyebrow">Каталог</p>
        <h1>{{ heading_title }}</h1>
      </header>
      <form class="catalog-search-panel" action="{{ search_url }}" method="get" aria-label="{{ text_catalog_search }}">
      <input type="hidden" name="route" value="product/search" />
      <label class="control-label" for="input-search">{{ text_catalog_search_label }}</label>
      <div class="row">
        <div class="col-sm-4">
          <input type="text" name="search" value="{{ search }}" placeholder="{{ text_catalog_search_placeholder }}" id="input-search" class="form-control" />
        </div>
        <div class="col-sm-3">
          <label class="sr-only" for="input-category">{{ text_all_categories }}</label>
          <select name="category_id" id="input-category" class="form-control">
            <option value="0">{{ text_all_categories }}</option>
            {% for category_1 in categories %}
            {% if category_1.category_id == category_id %}
            <option value="{{ category_1.category_id }}" selected="selected">{{ category_1.name }}</option>
            {% else %}
            <option value="{{ category_1.category_id }}">{{ category_1.name }}</option>
            {% endif %}
            {% for category_2 in category_1.children %}
            {% if category_2.category_id == category_id %}
            <option value="{{ category_2.category_id }}" selected="selected">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ category_2.name }}</option>
            {% else %}
            <option value="{{ category_2.category_id }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ category_2.name }}</option>
            {% endif %}
            {% for category_3 in category_2.children %}
            {% if category_3.category_id == category_id %}
            <option value="{{ category_3.category_id }}" selected="selected">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ category_3.name }}</option>
            {% else %}
            <option value="{{ category_3.category_id }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ category_3.name }}</option>
            {% endif %}
            {% endfor %}
            {% endfor %}
            {% endfor %}
          </select>
        </div>
        <div class="col-sm-3">
          <label class="checkbox-inline">
            {% if sub_category %}
            <input type="checkbox" name="sub_category" value="1" checked="checked" />
            {% else %}
            <input type="checkbox" name="sub_category" value="1" />
            {% endif %}
            {{ text_search_subcategories }}</label>
        </div>
      </div>
      <p>
        <label class="checkbox-inline">
          {% if description %}
          <input type="checkbox" name="description" value="1" id="description" checked="checked" />
          {% else %}
          <input type="checkbox" name="description" value="1" id="description" />
          {% endif %}
          {{ text_search_description }}</label>
      </p>
      <button type="submit" id="button-search" class="btn btn-primary">{{ button_search }}</button>
      </form>
      {% if products %}
      <div class="catalog-toolbar">
        <div class="catalog-toolbar__count">{{ results }}</div>
        <div class="catalog-toolbar__controls">
          <div class="catalog-toolbar__field">
            <label for="input-sort">{{ text_sort }}</label>
            <select id="input-sort" class="form-control" data-location-select>
              {% for sorts in sorts %}
              {% if sorts.value == '%s-%s'|format(sort, order) %}
              <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
              {% else %}
              <option value="{{ sorts.href }}">{{ sorts.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </div>
          <div class="catalog-toolbar__field">
            <label for="input-limit">{{ text_limit }}</label>
            <select id="input-limit" class="form-control" data-location-select>
              {% for limits in limits %}
              {% if limits.value == limit %}
              <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
              {% else %}
              <option value="{{ limits.href }}">{{ limits.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </div>
        </div>
      </div>
      <div class="catalog-grid">
        {% for product in products %}
        {% set heading_level = 'h2' %}
        {% set enable_quick_view = false %}
        {% include 'product/product_card.twig' %}
        {% endfor %}
      </div>
      <nav class="catalog-pagination" aria-label="{{ text_pagination_navigation }}">{{ pagination }}</nav>
      {% else %}
      <p class="catalog-empty">{{ text_catalog_search_empty }}</p>
      <p><a class="btn btn-primary" href="{{ search_url }}">{{ button_open_catalog }}</a></p>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</main>
{% if catalog_schema %}
<script nonce="{{ csp_nonce }}" type="application/ld+json">{{ catalog_schema|raw }}</script>
{% endif %}
{{ footer }}
