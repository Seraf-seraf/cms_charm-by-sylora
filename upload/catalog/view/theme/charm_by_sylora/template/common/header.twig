<!DOCTYPE html>
<!--[if IE]><![endif]-->
<!--[if IE 8 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie8"><![endif]-->
<!--[if IE 9 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie9"><![endif]-->
<!--[if (gt IE 9)|!(IE)]><!-->
<html dir="{{ direction }}" lang="{{ lang }}">
<!--<![endif]-->
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ title }}</title>
<base href="{{ base }}" />
{% if description %}
<meta name="description" content="{{ description }}" />
{% endif %}
{% if keywords %}
<meta name="keywords" content="{{ keywords }}" />
{% endif %}
<meta name="robots" content="{{ robots }}" />
<meta property="og:type" content="{{ og_type }}" />
<meta property="og:title" content="{{ og_title }}" />
{% if og_description %}
<meta property="og:description" content="{{ og_description }}" />
{% endif %}
<meta property="og:url" content="{{ og_url }}" />
<meta property="og:image" content="{{ og_image }}" />
{% if site_schema %}
<script nonce="{{ csp_nonce }}" type="application/ld+json">{{ site_schema|raw }}</script>
{% endif %}
<script src="catalog/view/javascript/jquery/jquery-3.7.1.min.js" type="text/javascript"></script>
<link href="catalog/view/javascript/bootstrap/css/bootstrap.min.css" rel="stylesheet" media="screen" />
<script src="catalog/view/javascript/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>
<link href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
<link href="catalog/view/theme/charm_by_sylora/stylesheet/stylesheet.min.css?v=20260816-catalog-layout-v4" rel="stylesheet">
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
<script src="catalog/view/javascript/common.min.js?v=20260802-cart-v1" type="text/javascript"></script>
<script src="catalog/view/javascript/storefront.js?v=20260815-csp-v1" type="text/javascript"></script>
{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}" />
{% endfor %}
<link rel="apple-touch-icon" sizes="180x180" href="image/catalog/sylora/favicons/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="image/catalog/sylora/favicons/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="image/catalog/sylora/favicons/favicon-16x16.png">
<link rel="icon" href="image/catalog/sylora/favicons/favicon.ico">
<link rel="manifest" href="image/catalog/sylora/favicons/site.webmanifest">
{% for analytic in analytics %}
{{ analytic }}
{% endfor %}
</head>
<body>
{% set account_url = logged ? account : login %}
{% set account_label = logged ? 'Личный кабинет' : 'Войти' %}
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-brand" href="{{ home }}" aria-label="Charm by Sylora">
      {% if brand_logo_image.src %}
      <picture>
        {% for source in brand_logo_image.sources %}
        <source srcset="{{ source.src }}" type="{{ source.type }}">
        {% endfor %}
        <img class="site-brand__logo" src="{{ brand_logo_image.src }}" alt="" width="54" height="54" loading="eager" decoding="async">
      </picture>
      {% endif %}
      <span class="site-brand__text">
        <span class="site-brand__mark">Charm by Sylora</span>
        <span class="site-brand__sub">украшения ручной работы</span>
      </span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Основное меню">
      <a href="{{ home }}">Главная</a>
      <a href="{{ catalog }}">Каталог</a>
      <a href="{{ about }}">Обо мне</a>
      <a href="{{ contact }}">Контакты</a>
      <a href="{{ shopping_cart }}">Корзина</a>
      <a class="site-nav__account" href="{{ account_url }}" aria-label="{{ account_label }}">
        <i class="fa fa-user" aria-hidden="true"></i>
        <span>{{ account_label }}</span>
      </a>
    </nav>

    <div class="site-actions">
      <div class="site-search">{{ search }}</div>
      <a class="site-account" href="{{ account_url }}" aria-label="{{ account_label }}">
        <i class="fa fa-user" aria-hidden="true"></i>
        <span class="site-account__label">{{ account_label }}</span>
      </a>
      <button class="theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false">
        <i class="fa fa-moon-o" aria-hidden="true"></i>
      </button>
      <div class="site-cart">{{ cart }}</div>
      <button class="mobile-nav-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="site-nav">
        <i class="fa fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>
<div class="site-nav-backdrop" hidden></div>
<div id="site-notifications" class="site-notifications container" aria-live="polite" aria-atomic="true"></div>
