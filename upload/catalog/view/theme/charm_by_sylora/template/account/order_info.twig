{{ header }}
<div id="account-order" class="container order-info-page">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      {{ account_navigation }}
      <main class="atelier-account-page-content order-detail-page__content">
        {% if success %}
        <div class="alert alert-success alert-dismissible"><img class="atelier-icon atelier-icon--check" src="catalog/view/theme/charm_by_sylora/image/icons/atelier/check.svg" alt="" aria-hidden="true"> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        {% if error_warning %}
        <div class="alert alert-danger alert-dismissible"><img class="atelier-icon atelier-icon--alert" src="catalog/view/theme/charm_by_sylora/image/icons/atelier/alert.svg" alt="" aria-hidden="true"> {{ error_warning }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}

        {% set heading_tag = account_navigation ? 'h2' : 'h1' %}
        {% set subheading_tag = account_navigation ? 'h3' : 'h2' %}
        {% set detail_heading_tag = account_navigation ? 'h4' : 'h3' %}
        <{{ heading_tag }}>{{ text_order }} № {{ order_id }}</{{ heading_tag }}>
        <div class="order-detail-cards">
          <section class="order-detail-card order-detail-card--information">
            <{{ subheading_tag }}>{{ text_order_information }}</{{ subheading_tag }}>
            <p class="order-detail-card__description">{{ text_order_date_status }}</p>
            <dl class="order-detail-data">
              {% if invoice_no %}
              <div><dt>{{ text_invoice_no|trim(':') }}</dt><dd>{{ invoice_no }}</dd></div>
              {% endif %}
              <div><dt>{{ text_date_added|trim(':') }}</dt><dd>{{ date_added }}</dd></div>
              {% if order_status %}
              <div><dt>{{ text_current_status }}</dt><dd>{{ order_status }}</dd></div>
              {% endif %}
              {% if payment_method %}
              <div><dt>{{ text_payment_method|trim(':') }}</dt><dd>{{ payment_method }}</dd></div>
              {% endif %}
              {% if shipping_method %}
              <div><dt>{{ text_shipping_method|trim(':') }}</dt><dd>{{ shipping_method }}</dd></div>
              {% endif %}
            </dl>
            <div class="order-detail-history">
              <{{ detail_heading_tag }}>{{ text_history }}</{{ detail_heading_tag }}>
              {% if histories %}
              <ol>
                {% for history in histories %}
                <li>
                  <p><time>{{ history.date_added }}</time><span>{{ history.status }}</span></p>
                  {% if history.comment %}<div>{{ history.comment }}</div>{% endif %}
                </li>
                {% endfor %}
              </ol>
              {% else %}
              <p class="order-detail-history__empty">{{ text_no_results }}</p>
              {% endif %}
            </div>
          </section>

          <section class="order-detail-card order-detail-card--delivery">
            <{{ subheading_tag }}>{{ text_delivery }}</{{ subheading_tag }}>
            <p class="order-detail-card__description">{{ text_delivery_recipient }}</p>
            {% if shipping_address %}
            <div class="order-detail-address">
              <{{ detail_heading_tag }}>{{ text_shipping_address }}</{{ detail_heading_tag }}>
              <p>{{ shipping_address }}</p>
            </div>
            {% endif %}
            {% if payment_address %}
            <div class="order-detail-address">
              <{{ detail_heading_tag }}>{{ text_payment_address }}</{{ detail_heading_tag }}>
              <p>{{ payment_address }}</p>
            </div>
            {% endif %}
          </section>

          <section class="order-detail-card order-detail-card--products">
            <{{ subheading_tag }}>{{ text_order_products }}</{{ subheading_tag }}>
            <p class="order-detail-card__description">{{ text_product_summary }}</p>
            {% for product in products %}
            <article class="order-detail-product">
              <{{ detail_heading_tag }}>{{ product.name }}</{{ detail_heading_tag }}>
              {% if product.model %}<p class="order-detail-product__model">{{ column_model }}: {{ product.model }}</p>{% endif %}
              {% if product.option %}
              <ul class="order-detail-product__options">
                {% for option in product.option %}<li>{{ option.name }}: {{ option.value }}</li>{% endfor %}
              </ul>
              {% endif %}
              <dl class="order-detail-product__data">
                <div><dt>{{ column_quantity }}</dt><dd>{{ product.quantity }}</dd></div>
                <div><dt>{{ column_price }}</dt><dd>{{ product.price }}</dd></div>
                <div><dt>{{ column_total }}</dt><dd>{{ product.total }}</dd></div>
              </dl>
              <div class="order-detail-product__actions">
                {% if product.reorder %}
                <a href="{{ product.reorder }}" data-toggle="tooltip" title="{{ button_reorder }}" aria-label="{{ button_reorder }}" class="btn btn-primary"><img class="atelier-icon atelier-icon--bag" src="catalog/view/theme/charm_by_sylora/image/icons/atelier/bag.svg" alt="" aria-hidden="true"></a>
                {% endif %}
                <a href="{{ product.return }}" data-toggle="tooltip" title="{{ button_return }}" aria-label="{{ button_return }}" class="btn btn-danger"><img class="atelier-icon atelier-icon--arrow-left" src="catalog/view/theme/charm_by_sylora/image/icons/atelier/arrow-left.svg" alt="" aria-hidden="true"></a>
              </div>
            </article>
            {% endfor %}
            {% for voucher in vouchers %}
            <article class="order-detail-product order-detail-product--voucher">
              <{{ detail_heading_tag }}>{{ voucher.description }}</{{ detail_heading_tag }}>
              <dl class="order-detail-product__data">
                <div><dt>{{ column_quantity }}</dt><dd>1</dd></div>
                <div><dt>{{ column_price }}</dt><dd>{{ voucher.amount }}</dd></div>
                <div><dt>{{ column_total }}</dt><dd>{{ voucher.amount }}</dd></div>
              </dl>
            </article>
            {% endfor %}
          </section>

          <section class="order-detail-card order-detail-card--totals">
            <{{ subheading_tag }}>{{ text_order_totals }}</{{ subheading_tag }}>
            <p class="order-detail-card__description">{{ text_total_summary }}</p>
            <dl class="order-detail-totals">
              {% for total in totals %}
              <div><dt>{{ total.title }}</dt><dd>{{ total.text }}</dd></div>
              {% endfor %}
            </dl>
            {% if comment %}
            <div class="order-detail-comment">
              <{{ detail_heading_tag }}>{{ text_comment }}</{{ detail_heading_tag }}>
              <p>{{ comment }}</p>
            </div>
            {% endif %}
          </section>
        </div>

        <div class="order-detail-page__actions">
          <a href="{{ continue }}" class="btn btn-default">{{ button_back_to_order_history }}</a>
        </div>
        {{ content_bottom }}
      </main>
    </div>
    {{ column_right }}</div>
</div>
{{ footer }}
