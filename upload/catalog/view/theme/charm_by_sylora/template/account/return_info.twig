{{ header }}
<div id="account-return" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      {{ account_navigation }}
      <main class="atelier-account-page-content">
      <div class="return-detail">
        <h1>{{ text_atelier_return_detail_title|format(return_id) }}</h1>
        <section class="return-detail__card">
          <h2>{{ text_atelier_return_information }}</h2>
          <dl class="return-detail__facts">
            <div><dt>{{ text_return_id }}</dt><dd>#{{ return_id }}</dd></div>
            <div><dt>{{ text_date_added }}</dt><dd>{{ date_added }}</dd></div>
            <div><dt>{{ text_status }}</dt><dd>{{ status }}</dd></div>
            <div><dt>{{ text_order_id }}</dt><dd>#{{ order_id }}</dd></div>
            <div><dt>{{ text_date_ordered }}</dt><dd>{{ date_ordered }}</dd></div>
          </dl>
          <div class="return-detail__subsection">
            <h3>{{ text_atelier_return_customer }}</h3>
            <dl class="return-detail__facts">
              <div><dt>{{ entry_firstname }}</dt><dd>{{ firstname }} {{ lastname }}</dd></div>
              <div><dt>{{ entry_email }}</dt><dd>{{ email }}</dd></div>
              <div><dt>{{ entry_telephone }}</dt><dd>{{ telephone }}</dd></div>
            </dl>
          </div>
        </section>
        <section class="return-detail__card">
          <h2>{{ text_reason }}</h2>
          <dl>
            <div><dt>{{ column_reason }}</dt><dd>{{ reason }}</dd></div>
            <div><dt>{{ column_opened }}</dt><dd>{{ opened }}</dd></div>
            <div><dt>{{ column_action }}</dt><dd>{{ action }}</dd></div>
          </dl>
        </section>
        <section class="return-detail__card">
          <h2>{{ text_atelier_return_products }}</h2>
          <dl>
            <div><dt>{{ column_product }}</dt><dd>{{ product }}</dd></div>
            <div><dt>{{ column_model }}</dt><dd>{{ model }}</dd></div>
            <div><dt>{{ column_quantity }}</dt><dd>{{ quantity }}</dd></div>
          </dl>
        </section>
        <section class="return-detail__card">
          <h2>{{ text_atelier_return_history }}</h2>
          {% if comment %}
          <div class="return-detail__comment">
            <h3>{{ text_comment }}</h3>
            <p>{{ comment }}</p>
          </div>
          {% endif %}
          {% if histories %}
          {% for history in histories %}
          <dl>
            <div><dt>{{ column_date_added }}</dt><dd>{{ history.date_added }}</dd></div>
            <div><dt>{{ column_status }}</dt><dd>{{ history.status }}</dd></div>
            <div><dt>{{ column_comment }}</dt><dd>{{ history.comment }}</dd></div>
          </dl>
          {% endfor %}
          {% else %}
          <p>{{ text_no_results }}</p>
          {% endif %}
        </section>
        <div class="buttons clearfix"><a href="{{ continue }}" class="btn btn-default return-detail__back">{{ button_continue }}</a></div>
      </div>
      </main>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
