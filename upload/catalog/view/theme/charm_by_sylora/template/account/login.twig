{{ header }}
<main id="account-login" class="container account-auth">
  <div id="content" class="account-auth__content">{{ content_top }}
    <header class="account-auth__header">
      <h1>
        <span class="account-auth__title--mobile">{{ heading_title }}</span>
        <span class="account-auth__title--desktop">{{ text_account }}</span>
      </h1>
      <p class="account-auth__subtitle account-auth__subtitle--mobile">{{ text_i_am_returning_customer }}</p>
    </header>
    {% if success %}
    <div class="alert alert-success alert-dismissible" role="status"><img class="atelier-icon atelier-icon--check" src="catalog/view/theme/charm_by_sylora/image/icons/atelier/check.svg" alt="" aria-hidden="true"> {{ success }}</div>
    {% endif %}
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible" role="alert"><img class="atelier-icon atelier-icon--alert" src="catalog/view/theme/charm_by_sylora/image/icons/atelier/alert.svg" alt="" aria-hidden="true"> {{ error_warning }}</div>
    {% endif %}
    <div class="account-auth__grid">
      <section class="account-auth__card account-auth__card--login">
        <div class="account-auth__login-heading">
          <h2 class="account-auth__login-title">{{ heading_title }}</h2>
          <p class="account-auth__subtitle account-auth__subtitle--card">{{ text_i_am_returning_customer }}</p>
        </div>
        <form class="account-auth__form" action="{{ action }}" method="post" enctype="multipart/form-data">
          <div class="form-group">
            <label class="control-label" for="input-email">{{ entry_email }}</label>
            <input type="email" name="email" value="{{ email }}" placeholder="{{ text_email_placeholder }}" id="input-email" class="form-control" autocomplete="email" />
          </div>
          <div class="form-group">
            <label class="control-label" for="input-password">{{ entry_password }}</label>
            <input type="password" name="password" value="{{ password }}" placeholder="{{ text_password_placeholder }}" id="input-password" class="form-control" autocomplete="current-password" />
          </div>
          <div class="account-auth__actions">
            <input type="submit" value="{{ button_login }}" class="btn btn-primary" />
            <a href="{{ forgotten }}">{{ text_forgotten }}</a>
          </div>
          {% if redirect %}
          <input type="hidden" name="redirect" value="{{ redirect }}" />
          {% endif %}
        </form>
        <a href="{{ register }}" class="account-auth__create-account">{{ text_create_account }}</a>
      </section>
      <section class="account-auth__card account-auth__card--register">
        <h2>{{ text_new_customer }}</h2>
        <p>{{ text_register_account }}</p>
        <a href="{{ register }}" class="btn btn-default">{{ text_register }}</a>
      </section>
    </div>
    {{ content_bottom }}
  </div>
</main>
{{ footer }}
