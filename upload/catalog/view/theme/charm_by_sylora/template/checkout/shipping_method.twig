{% if error_warning %}
<div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
{% endif %}
{% if shipping_methods %}
<p>{{ text_shipping_method }}</p>
<div class="shipping-methods" data-shipping-methods aria-busy="false">
{% for shipping_method in shipping_methods %}
<section class="shipping-methods__group">
<p class="shipping-methods__title">{{ shipping_method.title }}</p>
{% if not shipping_method.error %}
<div class="shipping-methods__list">
{% for quote in shipping_method.quote %}
<label class="shipping-method-card">{% if quote.code == code or not code %}
    {% set code = quote.code %}
    <input class="shipping-method-card__control" type="radio" name="shipping_method" value="{{ quote.code }}" checked="checked" />
    {% else %}
    <input class="shipping-method-card__control" type="radio" name="shipping_method" value="{{ quote.code }}" />
    {% endif %}
  <span class="shipping-method-card__marker" aria-hidden="true"></span>
  <span class="shipping-method-card__title">{{ quote.title }}</span>
  <span class="shipping-method-card__price">{{ quote.text }}</span>
</label>
{% endfor %}
</div>
{% else %}
<div class="shipping-methods__status alert alert-danger alert-dismissible" role="alert">{{ shipping_method.error }}</div>
{% endif %}
</section>
{% endfor %}
</div>
{% endif %}
<p><strong>{{ text_comments }}</strong></p>
<p>
  <textarea name="comment" rows="8" class="form-control">{{ comment }}</textarea>
</p>
<div class="buttons">
  <div class="pull-right">
    <input type="button" value="{{ button_continue }}" id="button-shipping-method" data-loading-text="{{ text_loading }}" class="btn btn-primary" />
  </div>
</div>
