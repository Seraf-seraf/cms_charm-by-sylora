<div data-shipping-method-form>
{% if error_warning %}
<p class="alert shipping-methods__unavailable" role="alert">{{ error_warning }}</p>
{% if not shipping_methods %}
<div class="shipping-methods__empty-actions">
  <a href="{{ contact }}" class="btn btn-default shipping-methods__contact">{{ button_contact }}</a>
  <a href="#collapse-shipping-address" data-toggle="collapse" data-parent="#accordion" class="btn btn-default shipping-methods__change-address">{{ button_change_address }}</a>
</div>
{% endif %}
{% endif %}
{% if shipping_methods %}
<p class="shipping-methods__save-status" data-shipping-save-status role="status" hidden>{{ text_shipping_method_saving }}</p>
<p class="shipping-methods__intro">{{ text_shipping_method }}</p>
<div class="shipping-methods" data-shipping-methods aria-busy="false">
{% for shipping_method in shipping_methods %}
<section class="shipping-methods__group">
<p class="shipping-methods__title">{{ shipping_method.title }}</p>
{% if not shipping_method.error %}
<div class="shipping-methods__list">
{% for quote in shipping_method.quote %}
<label class="shipping-method-card">{% if quote.code == code or not code %}
    {% set code = quote.code %}
    <input class="shipping-method-card__control" type="radio" name="shipping_method" value="{{ quote.code }}" checked="checked" />
    {% else %}
    <input class="shipping-method-card__control" type="radio" name="shipping_method" value="{{ quote.code }}" />
    {% endif %}
  <span class="shipping-method-card__marker" aria-hidden="true"></span>
  <span class="shipping-method-card__title">{{ quote.title }}</span>
  <span class="shipping-method-card__price">{{ quote.text }}</span>
</label>
{% endfor %}
</div>
{% else %}
<div class="shipping-methods__status alert alert-danger alert-dismissible" role="alert">{{ shipping_method.error }}</div>
{% endif %}
</section>
{% endfor %}
</div>
<div class="shipping-methods__comment">
  <label for="input-shipping-comment">{{ text_comments }}</label>
  <textarea id="input-shipping-comment" name="comment" rows="1" class="form-control">{{ comment }}</textarea>
</div>
<div class="buttons shipping-methods__actions">
  <input type="button" value="{{ button_continue }}" id="button-shipping-method" data-loading-text="{{ button_continue }}" class="btn btn-primary" />
</div>
{% endif %}
</div>
